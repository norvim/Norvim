# Core
MONGO_URI=your_mongodb_connection_string
JWT_SECRET=replace_with_a_long_random_secret
NODE_ENV=production

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Email / Resend
RESEND_API_KEY=your_resend_api_key
RESEND_FROM_EMAIL=noreply@your-verified-domain.com
# RESEND_FROM_EMAIL must use a domain verified in Resend. onboarding@resend.dev is only for Resend-owned test sending and is not suitable for arbitrary production recipients.
RESEND_FROM_NAME=Norvim

# Paystack Kenya / M-PESA
# Use sk_test_... for testing or sk_live_... for production. No code change is required when switching.
PAYSTACK_SECRET_KEY=sk_test_your_key
PAYSTACK_WEBHOOK_SECRET=your_paystack_webhook_secret
NORVIM_COMMISSION_PERCENT=10

# Public production URL used when needed by external callbacks
APP_BASE_URL=https://yourdomain.com

# Admin/Norvim payout destination
ADMIN_PAYOUT_PHONE=2547XXXXXXXX

# Paystack test mode uses the documented Kenya test M-PESA number. Live mode uses the customer/profile number.
PAYSTACK_TEST_MPESA_PHONE=+254710000000
